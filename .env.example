# Copy to .env.local and fill in before running `eve dev` / `npm run dev`.

# Direct Anthropic access for the root agent and both subagents
# (agent/agent.ts, agent/subagents/*/agent.ts use eve/models/anthropic).
ANTHROPIC_API_KEY=

# Alternative: route model calls through Vercel AI Gateway instead of a
# direct provider key. Only needed if you switch agent.ts back to a
# "provider/model-id" string. Not required with the ANTHROPIC_API_KEY setup
# above.
# AI_GATEWAY_API_KEY=
