# Copy to .env.local and fill in before running `eve dev` / `npm run dev`.

# Direct Anthropic access for the root agent and both subagents
# (agent/agent.ts, agent/subagents/*/agent.ts use eve/models/anthropic), and
# for Sonnet/Opus in the benchmarks/ suite.
ANTHROPIC_API_KEY=

# Required for the jev leg of benchmarks/ (npm run bench:*) — jev
# (typesafe-ai/jev) is a Vercel AI Gateway model with no direct-provider
# path. Not needed for the chat agent itself unless you switch agent.ts back
# to a "provider/model-id" string.
AI_GATEWAY_API_KEY=
